# Set a real environment-specific connection string locally; never commit secrets.
DATABASE_URL=postgresql+psycopg://smog:local_only_change_me@localhost:5433/smog_test

# New FastAPI app; use /docs only in development.
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173
CACHE_TTL_SECONDS=720
STALE_MAX_SECONDS=3600
PUBLIC_RATE_LIMIT_PER_MINUTE=60

# OIDC_ISSUER / OIDC_AUDIENCE: required only once identity routes are added.
# Provider URLs are intentionally allowlisted in source and not user-editable.

# Optional fixed-origin Cloudflare data relay when Render cannot reach Open-Meteo.
OPEN_METEO_RELAY_ENABLED=0
