{
  "expo": {
    "name":"Winter Smog Assistant",
    "slug":"winter-smog-assistant",
    "scheme":"wintersmog",
    "version":"0.9.2",
    "orientation":"portrait",
    "userInterfaceStyle":"light",
    "newArchEnabled":true,
    "ios":{"supportsTablet":true,"bundleIdentifier":"com.winter.smogassistant"},
    "android":{"package":"com.winter.smogassistant","versionCode":3,"edgeToEdgeEnabled":true},
    "plugins":["expo-localization","expo-secure-store",
      ["expo-location",{
        "locationWhenInUsePermission":"Allow ClearSkies AI to use your location to show nearby air-quality estimates.",
        "isAndroidBackgroundLocationEnabled":false,
        "isAndroidForegroundServiceEnabled":false
      }]
    ],
    "extra":{"apiBase":"https://winter-smog-fastapi.onrender.com","communityBase":"https://winter-smog-community.1nc24cs197.workers.dev"}
  }
}
